PORT=3000

# Timezone (Nairobi Time = UTC+3)
TIMEZONE=Africa/Nairobi
TIMEZONE_OFFSET=3

# Apify (economic calendar scraping)
APIFY_API_KEY=your_apify_key_here
APIFY_BASE_URL=https://api.apify.com

# TwelveData (market data and forex prices)
TWELVE_DATA_API_KEY=your_twelve_data_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# MT5 Account
MT5_ENABLED=false
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=

# MT5 Python Bridge (trade execution)
MT5_PYTHON_SERVER_URL=http://localhost:8000

# Trading mode: OBSERVE, SIGNAL, AUTONOMOUS
TRADING_MODE=OBSERVE
TRADING_ENABLED=false

# Primary symbol
PRIMARY_SYMBOL=XAUUSD

# Risk settings
MAX_RISK_PER_TRADE=1
MAX_DAILY_LOSS=3
MAX_OPEN_TRADES=3
MAX_SYMBOL_EXPOSURE=2
MIN_RISK_REWARD=2
MAX_SPREAD=9999
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true

# News safety
NEWS_LOCK_BEFORE_MINUTES=5
NEWS_LOCK_AFTER_MINUTES=5
HIGH_IMPACT_NEWS_LOCK=true

# Position management
BREAK_EVEN_ENABLED=true

# Trading settings
IMPACT_FILTER=high,medium
POLL_INTERVAL_SECONDS=60
HOLDING_TIMES=5,15,30
CONFIDENCE_THRESHOLD=70
